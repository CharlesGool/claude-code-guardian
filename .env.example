# This project has no build-time .env — the running service reads its
# config from /etc/claude-guardian/config.env instead (written by
# `claude-guardian install` on first run). This file documents the same
# global-default variables for reference; see README.md -> Configuration.
# Per-instance overrides (WORKDIR, CLAUDE_ARGS, CLAUDE_BIN) are set via
# `claude-guardian new <name> --workdir ... --args ... --claude-bin ...`
# and live in /etc/claude-guardian/instances/<name>.env instead.

TMUX_SOCKET=/run/claude-guardian/tmux.sock
WORKDIR=/root
CLAUDE_BIN=claude
CLAUDE_ARGS=--permission-mode auto --remote-control
CHECK_INTERVAL_SEC=5
REQUIRED_APT_PKGS=tmux uuid-runtime
UNATTENDED_NUDGE_SEC=300
REMOTE_CONTROL_REFRESH_SEC=1200
CLAUDE_SESSIONS_DIR=${CLAUDE_CONFIG_DIR:-${HOME:-/root}/.claude}/sessions
MAX_SESSIONS=3
