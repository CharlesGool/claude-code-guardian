# This project has no build-time .env — the running service reads its
# config from /etc/claude-guardian/config.env instead (written by
# `claude-guardian install` on first run). This file documents the same
# global-default variables for reference; see README.md -> Configuration.
# Per-instance overrides (WORKDIR, CLAUDE_ARGS, CLAUDE_BIN) are set via
# `claude-guardian new <name> --workdir ... --args ... --claude-bin ...`
# and live in /etc/claude-guardian/instances/<name>.env instead.

# The account the tmux server, claude and the supervision loop run as.
# `install` writes the account it was sudo'd from; root is the fallback.
RUN_AS_USER=your-account
TMUX_SOCKET=/run/claude-guardian/tmux.sock
# empty = RUN_AS_USER's home directory, read from passwd
WORKDIR=
CLAUDE_BIN=claude
# claude refuses --dangerously-skip-permissions as root; a root install gets
# CLAUDE_ARGS=--permission-mode auto --remote-control instead
CLAUDE_ARGS=--dangerously-skip-permissions --remote-control
CHECK_INTERVAL_SEC=5
REQUIRED_APT_PKGS=tmux uuid-runtime
UNATTENDED_NUDGE_SEC=0
REMOTE_CONTROL_CHECK_SEC=5
REMOTE_CONTROL_RECONNECT_BACKOFF_SEC=60
# both empty = RUN_AS_USER's ~/.claude/{sessions,projects}
CLAUDE_SESSIONS_DIR=
CLAUDE_PROJECTS_DIR=
RESUME_AFTER_RESTART=1
MAX_SESSIONS=0
ENSURE_DEFAULT_INSTANCE=1
